# Copy to .env, fill in, then: chmod 600 .env
# Every key SPEC.md §3 knows. Only TELEGRAM_BOT_TOKEN is required.

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to use this instance. Empty = anyone. Set it.
ALLOWED_CHAT_IDS=

# en (default) or ru
BOT_LOCALE=

# Mi account. Leave both empty and the Xiaomi source is not offered; the weather is used instead.
XIAOMI_USERNAME=
XIAOMI_PASSWORD=
# de (default, the EU server) | cn | ru | sg | us | i2. A wrong region returns an empty device list.
XIAOMI_REGION=
# Optional. Normally resolved once during onboarding and stored in the state file.
XIAOMI_DEVICE_ID=
# Optional, recommended for a headless server: a passToken from one interactive login. With these
# set the bot never logs in with the password, so Xiaomi's login captcha cannot block it.
XIAOMI_USER_ID=
XIAOMI_PASS_TOKEN=

# Optional. Personal OpenAI key. Absent = the onboarding photo step is skipped entirely.
# Used only for the plant-photo vision call (see vision.py, model gpt-5.4-mini).
PERSONAL_OPENAI_API_KEY=

# Defaults: 44.8 / 20.5 (Belgrade), Europe/Belgrade, 9 (09:00 local), data/state.json
LATITUDE=
LONGITUDE=
TIMEZONE=
ALERT_HOUR=
STATE_PATH=
